# Maven build output (recreated by every build)
/target/

# IntelliJ IDEA settings (personal to your machine)
/.idea/
*.iml

# VS Code settings
/.vscode/

# Reports written by option 7
/data/eod-report.txt

# Saved tickets (created on the first run from data/tickets.txt) and its temporary file
/data/tickets.json
/data/tickets.json.tmp

# My own practice/test files
/data/practice/

# Files created by a VS Code extension, not part of the project
/.github/modernize/
