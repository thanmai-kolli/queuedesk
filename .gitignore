# Maven build output (recreated by every build)
/target/

# IntelliJ IDEA settings (personal to your machine)
/.idea/
*.iml

# VS Code settings
/.vscode/

# Reports saved by POST /api/reports/eod/files
/data/reports/

# Files from the console version (before the REST + MySQL version)
/data/eod-report.txt
/data/tickets.json
/data/tickets.json.tmp

# Never commit passwords: if you keep local settings in a file, use this name
/src/main/resources/application-local.yml

# My own practice/test files
/data/practice/

# Files created by a VS Code extension, not part of the project
/.github/modernize/
