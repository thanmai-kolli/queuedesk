<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Spring Boot "parent" chooses compatible versions for every Spring library below,
       so most dependencies here have no <version>. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.queuedesk</groupId>
  <artifactId>queuedesk</artifactId>
  <version>2.0-SNAPSHOT</version>
  <name>QueueDesk</name>
  <description>A helpdesk ticketing REST API with Spring Boot and MySQL</description>

  <properties>
    <java.version>17</java.version>
    <!-- Two classes have a main method (the app and the Month 1 simulator); this is the app. -->
    <start-class>com.queuedesk.QueueDeskApplication</start-class>
    <springdoc.version>2.8.17</springdoc.version>
  </properties>

  <dependencies>
    <!-- REST controllers, the embedded Tomcat web server, and Jackson for JSON. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Spring Data JPA + Hibernate: Java objects <-> database tables. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Bean Validation: @NotBlank, @Size, @Min ... on request classes. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- AOP: @Aspect, used to log how long each service call takes. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- The MySQL JDBC driver. Only needed when the app runs, not to compile. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Swagger UI: a web page at /swagger-ui.html to try every endpoint. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Tests: JUnit 5, Mockito, AssertJ, MockMvc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- "mvn spring-boot:run" starts the app; "mvn package" builds a runnable jar. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
